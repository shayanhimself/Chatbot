<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The key is encrypted against a Keystore master key that never leaves this device, so a
         copy restored anywhere else is undecryptable. Onboarding asks for it again instead.
         Device transfer needs the same exclusion: a new phone has a different Keystore. -->
    <cloud-backup>
        <exclude domain="file" path="datastore/api_key.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/api_key.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
